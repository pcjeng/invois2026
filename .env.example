# Salin fail ini kepada ".env" dan isi dengan kunci Supabase anda.
# Dapatkan di: Supabase Dashboard → Project Settings → API
# (Project URL + anon public key)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary — untuk upload logo/signature & simpan PDF ke cloud (pilihan)
# cloudinary.com → Settings → Upload → Add upload preset → Signing Mode: Unsigned
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
